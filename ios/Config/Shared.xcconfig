// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Boyk
PRODUCT_DISPLAY_NAME = Boyk
PRODUCT_BUNDLE_IDENTIFIER = org.boyk.app
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 8

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = SupportFiles/Info.plist
INFOPLIST_KEY_UISupportedInterfaceOrientations = portrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
INFOPLIST_KEY_NSCameraUsageDescription = Boyk uses the camera to scan product barcodes and check them against your boycotts.
INFOPLIST_KEY_NSPhotoLibraryUsageDescription = Boyk uses your photo library so you can pick a profile picture and attach images to posts.

// ==========================================
// Code Signing
// ==========================================
// Boyk, Inc. Apple Developer Program team. Must match the App ID prefix on
// org.boyk.app and the AASA payload in public/_worker.js.
// CODE_SIGN_STYLE is Automatic (set in project.pbxproj), so Xcode manages the
// certificate and provisioning profile itself once signed in to this team.
DEVELOPMENT_TEAM = D5H5726S52

// ==========================================
// Entitlements
// ==========================================
// CODE_SIGN_ENTITLEMENTS is set per configuration, not here:
//   Debug.xcconfig   -> Config/Boyk.entitlements          (aps-environment = development)
//   Release.xcconfig -> Config/Boyk.Release.entitlements  (aps-environment = production)
// Archive builds with the Release configuration, so distribution builds carry
// "production" explicitly. When adding a capability, add it to BOTH files.
