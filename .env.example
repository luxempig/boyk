# The site builds and runs as a read-only demo with no configuration at all.
# Everything below is only needed to run the live backend
# (VITE_LIVE_BACKEND=true for the build, LIVE_BACKEND=true on the Worker).

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Neo4j graph (api/ and pipeline/)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Cloudflare (Pages deploy, R2 snapshot upload)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Data pipeline API keys
FEC_API_KEY=

# Company logos
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=
