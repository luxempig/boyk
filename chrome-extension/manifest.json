{
  "manifest_version": 3,
  "name": "Boyk - Boycott Tracker",
  "version": "1.0.1",
  "key": "",
  "description": "Get notified when you visit websites of companies you're boycotting",
  "permissions": ["storage", "tabs", "alarms", "identity"],
  "host_permissions": ["https://*.supabase.co/*", "https://boyk.org/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["warning.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
